<!-- Conteúdo principal -->
<main class="flex-fill p-4" id="mainContent-<%= @theme %>">

  <!-- CARDS DO TOPO -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card shadow-sm text-center">
        <div class="card-body">
          <h6><%= t("dashboard.cards.total_balance") %></h6>
          <h4 class="text-success fw-bold">R$ 2.750,00</h4>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm text-center">
        <div class="card-body">
          <h6><%= t("dashboard.cards.income_month") %></h6>
          <h4 class="text-primary fw-bold">R$ 7.200,00</h4>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm text-center">
        <div class="card-body">
          <h6><%= t("dashboard.cards.expenses_month") %></h6>
          <h4 class="text-danger fw-bold">R$ 5.400,00</h4>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm text-center">
        <div class="card-body">
          <h6><%= t("dashboard.cards.open_invoices") %></h6>
          <h4 class="text-warning fw-bold">R$ 1.400,00</h4>
        </div>
      </div>
    </div>
  </div>

  <!-- GRÁFICOS -->
  <div id="graficos">
    <div class="row g-4">

      <!-- Gráfico de barras -->
      <div class="col-md-8">
        <div class="card shadow-sm">
          <div class="card-body">
            <h6 class="mb-4"><%= t("dashboard.charts.income_vs_expenses") %></h6>

            <p class="mb-1"><%= t("dashboard.charts.income") %></p>
            <div class="progress mb-3">
              <div class="progress-bar bg-primary" style="width: 75%">R$ 7.200</div>
            </div>

            <p class="mb-1"><%= t("dashboard.charts.expenses") %></p>
            <div class="progress mb-3">
              <div class="progress-bar bg-danger" style="width: 55%">R$ 5.400</div>
            </div>

            <p class="mb-1"><%= t("dashboard.charts.balance") %></p>
            <div class="progress mb-3">
              <div class="progress-bar bg-success" style="width: 35%">R$ 2.750</div>
            </div>

            <p class="mb-1"><%= t("dashboard.cards.open_invoices") %></p>
            <div class="progress">
              <div class="progress-bar bg-warning" style="width: 20%">R$ 1.400</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Gráfico pizza -->
      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body text-center">
            <h6 class="mb-3"><%= t("dashboard.charts.distribution") %></h6>

            <div class="position-relative mx-auto mb-3 d-flex justify-content-center align-items-center"
              style="
                width: clamp(140px, 40vw, 180px);
                height: clamp(140px, 40vw, 180px);
                border-radius: 50%;
                background: conic-gradient(
                  #005eff 0% 42.98%,
                  #ff1e3c 42.98% 75.21%,
                  #00c26e 75.21% 91.62%,
                  #ffcd1a 91.62% 100%
                );
                box-shadow: 0 6px 18px rgba(0,0,0,.15);
              ">

              <span class="position-absolute text-white fw-semibold"
                    style="top: 40%; left: 74.5%; font-size: .7rem;">
                <%= t("dashboard.charts.income") %><br>42%
              </span>

              <span class="position-absolute text-white fw-semibold"
                    style="top: 71.5%; left: 18%; font-size: .7rem;">
                <%= t("dashboard.charts.expenses") %><br>30%
              </span>

              <span class="position-absolute text-dark fw-semibold"
                    style="top: 5%; left: 33%; font-size: .7rem;">
                Open<br>15%
              </span>

              <span class="position-absolute text-white fw-semibold"
                    style="top: 25%; left: 12%; font-size: .7rem;">
                <%= t("dashboard.charts.balance") %><br>15%
              </span>

              <div class="d-flex flex-column justify-content-center align-items-center"
                   id="inner-circle-<%= @theme %>">
                <small><%= t("dashboard.charts.total") %></small>
                <strong>100%</strong>
              </div>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-2 small">
              <span class="badge bg-primary"><%= t("dashboard.legend.income") %></span>
              <span class="badge bg-danger"><%= t("dashboard.legend.expenses") %></span>
              <span class="badge bg-success"><%= t("dashboard.legend.balance") %></span>
              <span class="badge bg-warning text-dark"><%= t("dashboard.legend.open_invoices") %></span>
            </div>

          </div>
        </div>
      </div>

    </div> <!-- row -->
  </div> <!-- graficos -->

  <!-- LEGENDA FINAL (fica no lugar correto, abaixo dos gráficos) -->
  <div class="legend-finish">
    <p class="mb-1">
      <span class="badge bg-primary me-2">&nbsp;</span>
      <%= t("dashboard.legend.income") %>
    </p>
    <p class="mb-1">
      <span class="badge bg-danger me-2">&nbsp;</span>
      <%= t("dashboard.legend.expenses") %>
    </p>
    <p class="mb-1">
      <span class="badge bg-success me-2">&nbsp;</span>
      <%= t("dashboard.legend.balance") %>
    </p>
    <p class="mb-0">
      <span class="badge bg-warning me-2">&nbsp;</span>
      <%= t("dashboard.legend.open_invoices") %>
    </p>
  </div>

</main>
