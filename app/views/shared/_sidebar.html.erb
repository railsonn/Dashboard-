<!-- Nav secundary vertical mais o conteudo ao lado -->
<div class="d-flex" id="container">
  <nav class="navbar flex-column vh-90 p-3 sidebar" style="width: 240px;" id="sidebarMenu">
    <div class="navbar-nav d-flex h-100 w-100">
      <div class="d-flex flex-column gap-3">

        <%= link_to root_path,
            class: "nav-link-#{theme} d-flex align-items-center gap-2 #{nav_active(root_path)}" do %>
          <i class="bi bi-speedometer2"></i>
          <%= t("sidebar.dashboard") %>
        <% end %>

        <%= link_to accounts_path,
            class: "nav-link-#{theme} d-flex align-items-center gap-2 #{nav_active(accounts_path)}" do %>
          <i class="bi bi-bank"></i>
          <%= t("sidebar.accounts") %>
        <% end %>

        <%= link_to transactions_path,
            class: "nav-link-#{theme} d-flex align-items-center gap-2 #{nav_active(transactions_path)}" do %>
          <i class="bi bi-arrow-left-right"></i>
          <%= t("sidebar.transactions") %>
        <% end %>

        <%= link_to budgets_path,
            class: "nav-link-#{theme} d-flex align-items-center gap-2 #{nav_active(budgets_path)}" do %>
          <i class="bi bi-sliders"></i>
          <%= t("sidebar.budgets") %>
        <% end %>

        <%= link_to invoices_path,
            class: "nav-link-#{theme} d-flex align-items-center gap-2 #{nav_active(invoices_path)}" do %>
          <i class="bi bi-receipt"></i>
          <%= t("sidebar.invoices") %>
        <% end %>

      </div>
    </div>
  </nav>
