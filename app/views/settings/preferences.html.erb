<div class="container-fluid py-4 <%= @theme %>-settings">
  <div class="row">
    <div class="col-lg-8 col-xl-6">
      <div class="card shadow-sm">
        <div class="card-body">

          <h4 class="mb-4"><%= t("settings.title") %></h4>

          <%= form_with url: settings_update_preferences_path, method: :patch, local: true do |f| %>

            <!-- Language -->
            <div class="mb-3">
              <label class="form-label d-block"><%= t("settings.language") %></label>

              <div class="btn-group" role="group">
                <%= link_to "🇧🇷 #{t("settings.languages.pt")}",
                    url_for(locale: "pt"),
                    class: "btn #{I18n.locale == :pt ? 'btn-primary' : 'btn-outline-primary'}" %>

                <%= link_to "🇺🇸 #{t("settings.languages.en")}",
                    url_for(locale: "en"),
                    class: "btn #{I18n.locale == :en ? 'btn-primary' : 'btn-outline-primary'}" %>
              </div>
            </div>

            <!-- Currency -->
            <div class="mb-3">
              <%= f.label :currency, t("settings.currency"), class: "form-label" %>
              <%= f.select :currency,
                    [[t("settings.currencies.usd"), "USD"],
                     [t("settings.currencies.brl"), "BRL"]],
                    {},
                    class: "form-select" %>
            </div>

            <!-- Theme -->
            <div class="mb-4">
              <label class="form-label d-block"><%= t("settings.theme") %></label>

              <div class="form-check form-check-inline">
                <%= f.radio_button :theme, "light", class: "form-check-input", checked: (@theme == "light") %>
                <%= f.label :theme_light, t("settings.theme_light"), class: "form-check-label" %>
              </div>

              <div class="form-check form-check-inline">
                <%= f.radio_button :theme, "dark", class: "form-check-input", checked: (@theme == "dark") %>
                <%= f.label :theme_dark, t("settings.theme_dark"), class: "form-check-label" %>
              </div>
            </div>

            <!-- Date Format -->
            <div class="mb-3">
              <%= f.label :date_format, t("settings.date_format"), class: "form-label" %>
              <%= f.select :date_format,
                    [["DD/MM/YYYY", "dd/mm/yyyy"], ["MM/DD/YYYY", "mm/dd/yyyy"]],
                    {},
                    class: "form-select" %>
            </div>

            <!-- Number Format -->
            <div class="mb-4">
              <%= f.label :number_format, t("settings.number_format"), class: "form-label" %>
              <%= f.select :number_format,
                    [["1.234,56", "pt"], ["1,234.56", "en"]],
                    {},
                    class: "form-select" %>
            </div>

            <div class="d-flex justify-content-end">
              <%= f.submit t("settings.save"), class: "btn btn-primary px-4" %>
            </div>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
