<%= form_with(model: transaction, class: "card shadow-sm") do |form| %>
  <div class="card-body">

    <% if transaction.errors.any? %>
      <div class="alert alert-danger mb-4">
        <h6 class="mb-2">
          <%= t(
                "transactions.form.errors_title",
                count: transaction.errors.count
              ) %>
        </h6>

        <ul class="mb-0 ps-3">
          <% transaction.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Transaction type -->
    <div class="mb-3">
      <%= form.label :transaction_type,
      t("transactions.form.transaction_type"),
      class: "form-label fw-semibold" %>

      <%= form.select :transaction_type,
        [
          [t("transactions.types.credit"), "CREDIT"],
          [t("transactions.types.debit"), "DEBIT"]
        ],
        { prompt: t("transactions.form.select_type") },
        class: "form-select transaction-type-select" %>
    </div>

    <!-- Amount -->
    <div class="mb-3">
      <%= form.label :amount, class: "form-label" %>
      <%= form.number_field :amount, class: "form-control" %>
    </div>

    <!-- Description -->
    <div class="mb-3">
      <%= form.label :description, class: "form-label" %>
      <%= form.text_field :description, class: "form-control" %>
    </div>

    <!-- Transaction date -->
    <div class="mb-3">
      <%= form.label :transaction_date, class: "form-label" %>
      <%= form.date_field :transaction_date, class: "form-control" %>
    </div>

    <!-- User -->
    <div class="mb-3">
      <%= form.label :user_id, class: "form-label" %>
      <%= form.text_field :user_id, class: "form-control" %>
    </div>

    <!-- Account -->
    <div class="mb-4">
      <%= form.label :account_id, class: "form-label" %>
      <%= form.text_field :account_id, class: "form-control" %>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-between align-items-center mt-4">

      <!-- Esquerda -->
      <%= link_to t("transactions.edit.back"),
            transactions_path,
            class: "btn btn-outline-secondary" %>

      <!-- Direita -->
      <div class="d-flex gap-2">
        <%= link_to t("transactions.edit.show"),
              @transaction,
              class: "btn btn-outline-primary" %>

        <%= form.submit t("transactions.form.submit"),
              class: "btn btn-primary fw-semibold px-4" %>
      </div>

    </div>


  </div>
<% end %>
