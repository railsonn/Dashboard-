<%= form_with(model: transaction) do |form| %>
  <% if transaction.errors.any? %>
    <div style="color: red">
      <h2>
        <%= t(
          "transactions.form.errors_title",
          count: transaction.errors.count
        ) %>
      </h2>

      <ul>
        <% transaction.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :transaction_type, t("transactions.form.transaction_type"), style: "display: block" %>
    <%= form.text_field :transaction_type %>
  </div>

  <div>
    <%= form.label :amount, t("transactions.form.amount"), style: "display: block" %>
    <%= form.number_field :amount %>
  </div>

  <div>
    <%= form.label :description, t("transactions.form.description"), style: "display: block" %>
    <%= form.text_field :description %>
  </div>

  <div>
    <%= form.label :transaction_date, t("transactions.form.transaction_date"), style: "display: block" %>
    <%= form.date_field :transaction_date %>
  </div>

  <div>
    <%= form.label :user_id, t("transactions.form.user_id"), style: "display: block" %>
    <%= form.text_field :user_id %>
  </div>

  <div>
    <%= form.label :account_id, t("transactions.form.account_id"), style: "display: block" %>
    <%= form.text_field :account_id %>
  </div>

  <div>
    <%= form.submit t("transactions.form.submit") %>
  </div>
<% end %>
