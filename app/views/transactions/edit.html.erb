<% content_for :title, t("transactions.edit.title") %>

<div class="container-fluid py-4 <%= @theme %>-settings edit-transaction-page">
  <div class="row">
    <div class="col-lg-8 col-xl-6">

      <!-- Título -->
      <h1 id="transaction-edit-title">
        <%= t("transactions.edit.heading") %>
      </h1>

      <!-- Card / Form -->
      <div class="card shadow-sm">
        <%= render "form", transaction: @transaction %>
      </div>

      <!-- Actions -->
      <div class="d-flex justify-content-between align-items-center mt-4">
        <%= link_to t("transactions.edit.back"),
              transactions_path,
              class: "btn btn-outline-secondary" %>

        <%= link_to t("transactions.edit.show"),
              @transaction,
              class: "btn btn-outline-primary" %>
      </div>

    </div>
  </div>
</div>
