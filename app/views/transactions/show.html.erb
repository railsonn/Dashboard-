<p style="color: green"><%= notice %></p>

<%= render @transaction %>

<div>
  <%= link_to t("transactions.show.edit"), edit_transaction_path(@transaction) %> |
  <%= link_to t("transactions.show.back"), transactions_path %>

  <%= button_to t("transactions.show.destroy"),
    @transaction,
    method: :delete,
    data: { confirm: t("transactions.show.confirm_destroy") } %>
</div>
