<div id="<%= dom_id transaction %>">
  <p>
    <strong><%= t("transactions.show.transaction_type") %>:</strong>
    <%= t(
          "transactions.types.#{transaction.transaction_type.downcase}",
          default: transaction.transaction_type
        ) %>
  </p>

  <p>
    <strong><%= t("transactions.show.amount") %>:</strong>
    <%= number_to_currency(transaction.amount) %>
  </p>

  <p>
    <strong><%= t("transactions.show.description") %>:</strong>
    <%= transaction.description %>
  </p>

  <p>
    <strong><%= t("transactions.show.transaction_date") %>:</strong>
    <%= t(transaction.transaction_date) %>
  </p>

  <p>
    <strong><%= t("transactions.show.user") %>:</strong>
    <%= transaction.user_id %>
  </p>

  <p>
    <strong><%= t("transactions.show.account") %>:</strong>
    <%= transaction.account_id %>
  </p>
</div>
