<div class="table-responsive" id="pages-table-<%= @theme %>">
  <table class="table table-striped table-hover align-middle mb-0">
    <thead class="text-uppercase small">
      <tr>
        <th><%= t("transactions.table.id") %></th>
        <th><%= t("transactions.table.transaction_date") %></th>
        <th><%= t("transactions.table.description") %></th>
        <th><%= t("transactions.table.amount") %></th>
        <th><%= t("transactions.table.type") %></th>
        <th class="text-center"><%= t("transactions.table.actions") %></th>
      </tr>
    </thead>
    
    <tbody>
      <% transactions.each do |transaction| %>
        <tr>
          <td class="fw-bold">
            <%= transaction.id %>
          </td>

          <td class="fw-bold">
            <%= t(transaction.transaction_date) %>
          </td>

          <td class="fw-medium">
            <%= transaction.description %>
          </td>

          <td class="fw-bold">
            <%= number_to_currency(transaction.amount) %>
          </td>
          
          <td>
            <span class="badge <%= transaction.transaction_type == 'CREDIT' ? 'bg-success text-light' : 'bg-danger text-light' %> text-uppercase small">
              <%= transaction.transaction_type == 'CREDIT' ? t("transactions.table.credit") : t("transactions.table.debit") %>
            </span>
          </td>

          <td class="text-center d-flex gap-2 justify-content-center">
            <%= link_to t("transactions.table.view"),
              transaction_path(transaction),
              class: "btn btn-sm btn-outline-primary fw-semibold" %>

            <%= link_to t("transactions.table.edit"),
              edit_transaction_path(transaction),
              class: "btn btn-sm btn-outline-warning fw-semibold" %>

            <%= link_to t("transactions.table.delete"),
              transaction_path(transaction),
              method: :delete,
              data: { confirm: t("transactions.table.confirm_delete") },
              class: "btn btn-sm btn-outline-danger fw-semibold" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="d-flex justify-content-end align-items-center mt-3">
    <%= paginate @transactions, pagination_theme: @theme %>
  </div>
</div>
