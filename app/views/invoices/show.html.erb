<div class="container-fluid py-4 <%= @theme %>-settings invoice-show-page">
  <div class="row">
    <div class="col-lg-8 col-xl-6">

      <h4 id="invoice-show-title">
        <%= t("invoices.show.title", default: "Invoice details") %>
      </h4>

      <div class="card shadow-sm invoice-show-card">
        <div class="card-body">

          <div class="invoice-details">
            <%= render @invoice %>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
