<div id="<%= dom_id invoice %>" class="invoice-details">
  <p>
    <strong><%= t("invoices.show.total_amount") %></strong>
    <span class="invoice-amount">
      <%= number_to_currency(invoice.total_amount) %>
    </span>
  </p>

  <p>
    <strong><%= t("invoices.show.due_date") %></strong>
    <span>
      <%= t(invoice.due_date) %>
    </span>
  </p>

  <p>
    <strong><%= t("invoices.show.status") %></strong>
    <span class="invoice-status">
      <%= invoice.status %>
    </span>
  </p>

  <p>
    <strong><%= t("invoices.show.account") %></strong>
    <span>
      <%= invoice.account_id %>
    </span>
  </p>

  <div class="d-flex justify-content-between align-items-center mt-4">
  <div class="d-flex gap-3">
    <%= link_to t("invoices.show.edit"),
          edit_invoice_path(@invoice),
          class: "btn btn-outline-primary px-4" %>

    <%= link_to t("invoices.show.back"),
          invoices_path,
          class: "btn btn-outline-secondary px-4" %>
  </div>

  <%= link_to t("invoices.show.destroy"),
        invoice_path(@invoice),
        data: { turbo_method: :delete, turbo_confirm: t("invoices.show.confirm", default: "Are you sure?") },
        class: "btn btn-outline-danger px-4" %>
</div>
</div>
