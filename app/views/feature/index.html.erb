<div id="content-diretor-<%= @theme %>">
  <div id="container-feature">

    <div id="div-title-<%= @theme %>">
      <h1><%= t("features.title") %></h1>
      <p><%= t("features.subtitle") %></p>
      <hr>
    </div>

    <div class="row g-4">
      <!-- Accounts -->
      <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body-<%= @theme %> text-center">
            <i class="bi bi-bank fs-1 text-primary mb-3"></i>
            <h5 class="card-title"><%= t("features.cards.accounts.title") %></h5>
            <p class="card-text">
              <%= t("features.cards.accounts.description") %>
            </p>
            <%= link_to t("features.learn_more"), accounts_path, class: "btn btn-link" %>
          </div>
        </div>
      </div>

      <!-- Transactions -->
      <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body-<%= @theme %> text-center">
            <i class="bi bi-arrow-left-right fs-1 text-success mb-3"></i>
            <h5 class="card-title"><%= t("features.cards.transactions.title") %></h5>
            <p class="card-text">
              <%= t("features.cards.transactions.description") %>
            </p>
            <%= link_to t("features.learn_more"), transactions_path, class: "btn btn-link" %>
          </div>
        </div>
      </div>

      <!-- Budgets -->
      <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body-<%= @theme %> text-center">
            <i class="bi bi-pie-chart fs-1 text-warning mb-3"></i>
            <h5 class="card-title"><%= t("features.cards.budgets.title") %></h5>
            <p class="card-text">
              <%= t("features.cards.budgets.description") %>
            </p>
            <%= link_to t("features.learn_more"), budgets_path, class: "btn btn-link" %>
          </div>
        </div>
      </div>

      <!-- Reports -->
      <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body-<%= @theme %> text-center">
            <i class="bi bi-graph-up fs-1 text-info mb-3"></i>
            <h5 class="card-title"><%= t("features.cards.reports.title") %></h5>
            <p class="card-text">
              <%= t("features.cards.reports.description") %>
            </p>
            <%= link_to t("features.learn_more"), report_index_path, class: "btn btn-link" %>
          </div>
        </div>
      </div>
    </div>

    <hr>

    <div class="text-center mt-5">
      <h5 class="fw-bold mb-3 text-get-<%= @theme %>">
        <%= t("features.cta.title") %>
      </h5>
      <%= link_to t("features.cta.button"), root_path, class: "btn btn-primary btn-lg" %>
    </div>

  </div>
</div>
