<div class="table-responsive" id="pages-table-<%= @theme %>">
  <table class="table table-striped table-hover align-middle mb-0">
    <thead class="text-uppercase small">
      <tr>
        <th><%= t("budgets.table.id") %></th>
        <th><%= t("budgets.table.year") %></th>
        <th><%= t("budgets.table.month") %></th>
        <th><%= t("budgets.table.limit_amount") %></th>
        <th class="text-center"><%= t("budgets.table.actions") %></th>
      </tr>
    </thead>

    
    <tbody>
    <% budgets.each_with_index do |budget, index| %>
      <tr>
        <td class="fw-bold">
          <%= budget.id %>
        </td>

        <td class="fw-bold">
          <%= budget.year %>
        </td>

        <td class="fw-medium">
          <%= budget.month %>
        </td>

        <td class="fw-bold">
          <%= number_to_currency(budget.limit_amount) %>
        </td>

        <td class="text-center d-flex gap-2 justify-content-center">
          <%= link_to t("budgets.actions.view"),
            budget_path(budget),
            class: "btn btn-sm btn-outline-primary fw-semibold" %>

          <%= link_to t("budgets.actions.edit"),
            edit_budget_path(budget),
            class: "btn btn-sm btn-outline-warning fw-semibold" %>

          <%= link_to t("budgets.actions.delete"),
            budget_path(budget),
            method: :delete,
            data: { confirm: t("budgets.actions.confirm") },
            class: "btn btn-sm btn-outline-danger fw-semibold" %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <div class="d-flex justify-content-end align-items-center mt-3">
    <%= paginate @budgets, pagination_theme: @theme %>
  </div>
</div>