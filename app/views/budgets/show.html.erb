<% content_for :title, t("budgets.show.title") %>

<div class="container-fluid py-4 <%= @theme %>-settings budget-show-page">
  <div class="row">
    <div class="col-lg-8 col-xl-6">

      <!-- Card principal (igual account show) -->
      <!-- Título -->
      <h4 id="budget-show-title" class="mb-4">
        <%= t("budgets.show.title", default: "Budget Details") %>
      </h4>

      <!-- Conteúdo do budget -->
      <div class="budget-details">
        <%= render @budget %>
      </div>

    </div>
  </div>
</div>
