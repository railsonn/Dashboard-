<div class="container-fluid py-4 <%= @theme %>-settings budget-show-page">
  <div class="row">
    <div class="col-lg-8 col-xl-6">
      <div class="card shadow-sm account-show-card">
        <div class="card-body">

          <div id="<%= dom_id budget %>">

            <p class="mb-3">
              <strong><%= t("budgets.show.user") %>:</strong><br>
              <span class="text-muted">
                <%= budget.user_id %>
              </span>
            </p>

            <p class="mb-3">
              <strong><%= t("budgets.show.categories") %>:</strong><br>
              <span class="text-muted">
                <%= budget.category_id %>
              </span>
            </p>

            <p class="mb-3">
              <strong><%= t("budgets.show.limit_amount") %>:</strong><br>
              <span class="fw-semibold">
                <%= number_to_currency(budget.limit_amount) %>
              </span>
            </p>

            <div class="row">
              <div class="col-md-6">
                <p class="mb-3">
                  <strong><%= t("budgets.show.month") %>:</strong><br>
                  <span class="text-muted">
                    <%= budget.month %>
                  </span>
                </p>
              </div>

              <div class="col-md-6">
                <p class="mb-3">
                  <strong><%= t("budgets.show.year") %>:</strong><br>
                  <span class="text-muted">
                    <%= budget.year %>
                  </span>
                </p>
              </div>
            </div>

            <!-- Ações -->
            <div class="d-flex justify-content-between align-items-center mt-4">

              <!-- Esquerda: Editar / Voltar -->
              <div class="d-flex gap-2">
                <%= link_to t("budgets.show.edit"),
                            edit_budget_path(@budget),
                            class: "btn btn-sm btn-outline-primary" %>

                <%= link_to t("budgets.show.back"),
                            budgets_path,
                            class: "btn btn-sm btn-outline-secondary" %>
              </div>

              <!-- Direita: Excluir -->
              <%= button_to t("budgets.show.destroy"),
                            @budget,
                            method: :delete,
                            data: { confirm: t("budgets.show.confirm", default: "Are you sure?") },
                            class: "btn btn-sm btn-outline-danger" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
