<div class="container-fluid py-4 <%= @theme %>-settings">
  <div class="row">
    <div class="col-lg-8 col-xl-6">

      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="mb-4">
            <%= t("accounts.form.title", default: "Account Form") %>
          </h4>

          <%= form_with(model: account, local: true) do |form| %>

            <% if account.errors.any? %>
              <div class="alert alert-danger">
                <strong>
                  <%= pluralize(account.errors.count, t("errors.messages.error", default: "error")) %>
                  <%= t("errors.messages.prohibited", default: "prohibited this record from being saved") %>
                </strong>

                <ul class="mb-0 mt-2">
                  <% account.errors.each do |error| %>
                    <li><%= error.full_message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- Account Type -->
            <div class="mb-3">
              <%= form.label :accountType,
                    t("accounts.form.account_type", default: "Account Type"),
                    class: "form-label" %>

              <%= form.text_field :accountType,
                    class: "form-control" %>
            </div>

            <!-- Name -->
            <div class="mb-3">
              <%= form.label :name,
                    t("accounts.form.name", default: "Name"),
                    class: "form-label" %>

              <%= form.text_field :name,
                    class: "form-control" %>
            </div>

            <!-- Balance -->
            <div class="mb-3">
              <%= form.label :balance,
                    t("accounts.form.balance", default: "Balance"),
                    class: "form-label" %>

              <%= form.number_field :balance,
                    step: "0.01",
                    class: "form-control" %>
            </div>

            <!-- User -->
            <div class="mb-4">
              <%= form.label :user_id,
                    t("accounts.form.user", default: "User"),
                    class: "form-label" %>

              <%= form.text_field :user_id,
                    class: "form-control",
                    disabled: true %>
            </div>


              <div class="d-flex justify-content-between mt-4">
                <%= link_to t("accounts.edit.back"),
                      accounts_path,
                      class: "btn btn-outline-secondary" %>

                <div class="d-flex gap-2">
                  <% if account.persisted? %>
                    <%= link_to t("accounts.edit.show"),
                          account,
                          class: "btn btn-outline-primary" %>

                    <%= button_to t("accounts.show.destroy"),
                          account,
                          method: :delete,
                          data: { confirm: t("accounts.show.confirm", default: "Are you sure?") },
                          class: "btn btn-outline-danger",
                          form_class: "d-inline" %>
                  <% end %>

                  <%= form.submit t("actions.save", default: "Save"),
                        class: "btn btn-primary px-4" %>
                </div>
              </div>
            </div>

          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
