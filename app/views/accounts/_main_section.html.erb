<div class="table-responsive" id="pages-table-<%= @theme %>">
  <table class="table table-striped table-hover align-middle mb-0">
    <thead class="text-uppercase small">
      <tr>
        <th><%= t("accounts.table.id") %></th>
        <th><%= t("accounts.table.name") %></th>
        <th><%= t("accounts.table.balance") %></th>
        <th><%= t("accounts.table.type") %></th>
        <th class="text-center"><%= t("accounts.table.actions") %></th>
      </tr>
    </thead>

    <tbody>
      <% @accounts.each_with_index do |account, index| %>
        <tr>
          <td class="fw-bold">
            <%= account.id %>
          </td>

          <td class="fw-medium">
            <%= account.name %>
          </td>

          <td class="fw-bold">
            <%= number_to_currency(account.balance) %>
          </td>

          <td>
            <span class="badge rounded-pill bg-primary px-3 py-1 text-uppercase">
              <%= account.accountType %>
            </span>
          </td>

          <td class="text-center d-flex gap-2 justify-content-center">
            <%= link_to t("accounts.table.view"),
              account_path(account),
              class: "btn btn-sm btn-outline-primary fw-semibold" %>

            <%= link_to t("accounts.table.edit"),
              edit_account_path(account),
              class: "btn btn-sm btn-outline-warning fw-semibold" %>

            <%= link_to t("accounts.table.delete"),
              account_path(account),
              method: :delete,
              data: { confirm: t("accounts.table.confirm_delete") },
              class: "btn btn-sm btn-outline-danger fw-semibold" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="d-flex justify-content-end align-items-center mt-3">
    <%= paginate @accounts, pagination_theme: @theme %>
  </div>
</div>
