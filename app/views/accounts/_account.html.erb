<div id="<%= dom_id account %>">
  <p>
    <strong><%= t("accounts.show.account_type") %>:</strong>
    <%= account.accountType %>
  </p>

  <p>
    <strong><%= t("accounts.show.name") %>:</strong>
    <%= account.name %>
  </p>

  <p>
    <strong><%= t("accounts.show.balance") %>:</strong>
    <%= account.balance %>
  </p>

  <p>
    <strong><%= t("accounts.show.user") %>:</strong>
    <%= account.user_id %>
  </p>
</div>
