<div class="container-fluid py-4 <%= @theme %>-settings">
  <div class="row">
    <div class="col-lg-8 col-xl-6">

      <% if notice.present? %>
        <div class="alert alert-success mb-4">
          <%= notice %>
        </div>
      <% end %>


      <h4 class="mb-4" id="account-show-title">
        <%= t("accounts.show.title", default: "Account Details") %>
      </h4>

      <%= render @account %>

    </div>
  </div>
</div>
