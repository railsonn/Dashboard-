<div class="container-fluid py-4 <%= @theme %>-settings">
  <div class="row">
    <div class="col-lg-8 col-xl-6">

      <% if notice.present? %>
        <div class="alert alert-success mb-4">
          <%= notice %>
        </div>
      <% end %>

      <div class="card shadow-sm account-show-card">
        <div class="card-body">

          <h4 class="mb-4">
            <%= t("accounts.show.title", default: "Account Details") %>
          </h4>

          <%= render @account %>

          <div class="d-flex justify-content-between align-items-center mt-4">
            <div class="d-flex gap-2">
              <%= link_to t("accounts.show.edit"),
                    edit_account_path(@account),
                    class: "btn btn-outline-primary" %>

              <%= link_to t("accounts.show.back"),
                    accounts_path,
                    class: "btn btn-outline-secondary" %>
            </div>

            <%= button_to t("accounts.show.destroy"),
                  @account,
                  method: :delete,
                  data: { confirm: t("accounts.show.confirm", default: "Are you sure?") },
                  class: "btn btn-outline-danger" %>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
